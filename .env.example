# OracleDesk frontend configuration. Copy to .env.local and edit.
#
# Every NEXT_PUBLIC_* value is compiled into JavaScript that browsers
# download. Never put a private key, secret seed or API secret here.

# Backend API (OracleDesk-Backend). Local: http://localhost:8000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Stellar network. Defaults are Stellar Testnet.
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=
NEXT_PUBLIC_STELLAR_RPC_URL=
NEXT_PUBLIC_STELLAR_EXPLORER_URL=

# Contract ids. Empty means "use lib/stellar/generated/deployments.testnet.json".
NEXT_PUBLIC_MARKET_CORE_CONTRACT_ID=
NEXT_PUBLIC_TREASURY_CONTRACT_ID=
NEXT_PUBLIC_RESOLVER_CONTRACT_ID=
NEXT_PUBLIC_REASONING_REGISTRY_CONTRACT_ID=
NEXT_PUBLIC_USDC_CONTRACT_ID=

# Where premium payments go. Must match the backend's PAYMENTS_RECIPIENT.
# Empty means the treasury contract (see docs/api.md).
NEXT_PUBLIC_PAYMENTS_RECIPIENT=
# Daily pass price shown and paid, in USDC. Must be >= the backend's
# DAILY_PASS_PRICE_RAW (default 0.5).
NEXT_PUBLIC_DAILY_PASS_PRICE_USDC=0.5

# Comma-separated G… addresses that see the admin pages. UI only: the
# backend enforces its own ADMIN_ADDRESSES.
NEXT_PUBLIC_ADMIN_ADDRESSES=

# Mobile wallets over WalletConnect (LOBSTR, Freighter Mobile). Empty turns it off.
# Get a project id at https://cloud.reown.com (WalletConnect Cloud). Add this app's
# origin to the project's allowed origins, or pairing is refused.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# This app's public URL, shown to the wallet while it pairs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# IPFS gateway for reading reasoning traces.
NEXT_PUBLIC_IPFS_GATEWAY_URL=https://ipfs.io/ipfs
# The contracts repo's x402 trace service (per-trace unlocks). Empty if not deployed.
NEXT_PUBLIC_X402_URL=
